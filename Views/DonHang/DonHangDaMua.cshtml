@model List<VVD_2210900012_DATN.Models.DonHang>

@inject VVD_2210900012_DATN.Models.BookstoreContext _context

@{
    ViewData["Title"] = "Đơn hàng đã mua";
}

<style>

    body {
        background: #f5f5f5;
    }

    .page-title {
        font-size: 42px;
        font-weight: 800;
        color: #222;
    }

    .filter-btn {
        border-radius: 30px;
        padding: 10px 22px;
        font-weight: 600;
    }

    .order-card {
        border: none;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        transition: 0.25s;
    }

        .order-card:hover {
            transform: translateY(-3px);
        }

    .book-img {
        width: 110px;
        height: 140px;
        object-fit: cover;
        border-radius: 14px;
        border: 1px solid #eee;
    }

    .book-name {
        font-size: 24px;
        font-weight: 700;
        color: #222;
    }

    .order-code {
        font-size: 18px;
        font-weight: 700;
        color: #0d6efd;
    }

    .order-status {
        font-size: 18px;
        font-weight: 700;
        color: #198754;
    }

    .price {
        font-size: 28px;
        font-weight: 800;
        color: #dc3545;
    }

    .detail-btn {
        border-radius: 30px;
        padding: 10px 26px;
        font-weight: 600;
        min-width: 160px;
    }

    .review-btn {
        border-radius: 30px;
        padding: 10px 26px;
        font-weight: 600;
        min-width: 160px;
        color: white;
    }

</style>

<div class="container mt-5 mb-5">

    <!-- TITLE -->

    <h1 class="page-title mb-4">

        ĐƠN HÀNG ĐÃ MUA

    </h1>

    <!-- FILTER -->

    <div class="mb-4 d-flex gap-3 flex-wrap">

        <a asp-controller="DonHang"
           asp-action="DonHangDaMua"
           class="btn btn-outline-primary filter-btn">

            Tất cả

        </a>

        <a asp-controller="DonHang"
           asp-action="DonHangDaMua"
           asp-route-status="ChoXacNhan"
           class="btn btn-outline-warning filter-btn">

            Chờ xử lý

        </a>

        <a asp-controller="DonHang"
           asp-action="DonHangDaMua"
           asp-route-status="DaXacNhan"
           class="btn btn-outline-info filter-btn">

            Đã xác nhận

        </a>

        <a asp-controller="DonHang"
           asp-action="DonHangDaMua"
           asp-route-status="HoanThanh"
           class="btn btn-outline-success filter-btn">

            Hoàn thành

        </a>

    </div>

    <!-- EMPTY -->
    @if (!Model.Any())
    {
        <div class="alert alert-warning shadow-sm rounded-4 p-4 fs-5">

            Chưa có đơn hàng nào

        </div>
    }
    else
    {

        @foreach (var don in Model)
        {

            // =================================================
            // CHI TIẾT ĐƠN
            // =================================================

            var chiTiet = _context.ChiTietDonHangs

            .FirstOrDefault(x =>

            x.MaDonHang
            == don.MaDonHang
            );

            // =================================================
            // BIẾN THỂ
            // =================================================

            var bienThe = chiTiet != null

            ? _context.BienTheSaches
            .FirstOrDefault(x =>

            x.Id
            == chiTiet.BienTheId
            )

            : null;

            // =================================================
            // SÁCH
            // =================================================

            var sach = bienThe != null

            ? _context.SanPhams
            .FirstOrDefault(x =>

            x.Id
            == bienThe.SanPhamId
            )

            : null;

            <!-- CARD -->

            <div class="card order-card mb-4">

                <div class="card-body p-4">

                    <!-- HEADER -->

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div class="order-code">

                            Đơn hàng:
                            #@don.MaDonHangCode

                        </div>

                        <div class="order-status">

                            @don.TrangThai

                        </div>

                    </div>

                    <hr />

                    <!-- CONTENT -->

                    <div class="row align-items-center">

                        <!-- IMAGE -->

                        <div class="col-md-2 text-center">

                            <img src="~/images/@(sach?.AnhBia ?? "no-image.png")"
                                 class="book-img" />

                        </div>

                        <!-- INFO -->

                        <div class="col-md-7">

                            <div class="book-name mb-2">

                                @(sach?.TenSach ?? "Sản phẩm")

                            </div>

                            <div class="text-muted fs-5">

                                Ngày đặt:
                                @(don.NgayDat?.ToString("dd/MM/yyyy"))

                            </div>

                            <div class="mt-3 price">

                                @((don.TongTien ?? 0).ToString("N0")) đ

                            </div>

                        </div>

                        <!-- BUTTON -->

                        <div class="col-md-3 text-end">

                            <div class="d-flex flex-column gap-2 align-items-end">

                                <!-- CHI TIẾT -->

                                <a asp-controller="DonHang"
                                   asp-action="ChiTiet"
                                   asp-route-id="@don.MaDonHang"
                                   class="btn btn-primary detail-btn">

                                    Xem chi tiết

                                </a>

                                <!-- ĐÁNH GIÁ -->
                                @if (sach != null)
                                {
                                    <a href="/DanhGia/Create?sanPhamId=@sach.Id"
                                       class="btn btn-warning review-btn">

                                        ⭐ Đánh giá

                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        }

    }

</div>