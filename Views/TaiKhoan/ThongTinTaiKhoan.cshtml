@model VVD_2210900012_DATN.Models.NguoiDung

@{
    ViewData["Title"] = "Thông tin tài khoản";
}

<style>

    body {
        background: #f5f5f5;
    }

    .profile-container {
        max-width: 1000px;
        margin: 40px auto;
    }

    .profile-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .profile-title {
        text-align: center;
        font-size: 38px;
        font-weight: bold;
        color: #ff6a00;
        margin-bottom: 40px;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .profile-group {
        display: flex;
        flex-direction: column;
    }

    .profile-label {
        font-weight: 600;
        margin-bottom: 8px;
        color: #444;
    }

    .profile-value {
        height: 55px;
        border-radius: 14px;
        background: #f1f1f1;
        padding: 0 15px;
        display: flex;
        align-items: center;
        font-size: 16px;
    }

    .btn-edit {
        display: block;
        width: 100%;
        margin-top: 35px;
        height: 58px;
        border: none;
        border-radius: 15px;
        background: #0d6efd;
        color: white;
        text-align: center;
        line-height: 58px;
        text-decoration: none;
        font-size: 18px;
        font-weight: bold;
    }

</style>

<div class="profile-container">

    <div class="profile-card">

        <div class="profile-title">
            THÔNG TIN TÀI KHOẢN
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <div class="profile-grid">

            <div class="profile-group">

                <label class="profile-label">
                    Tài khoản
                </label>

                <div class="profile-value">
                    @Model.TenDangNhap
                </div>

            </div>

            <div class="profile-group">

                <label class="profile-label">
                    Vai trò
                </label>

                <div class="profile-value">
                    @Model.VaiTro
                </div>

            </div>

            <div class="profile-group">

                <label class="profile-label">
                    Họ tên
                </label>

                <div class="profile-value">
                    @Model.HoTen
                </div>

            </div>

            <div class="profile-group">

                <label class="profile-label">
                    Email
                </label>

                <div class="profile-value">
                    @Model.Email
                </div>

            </div>

            <div class="profile-group">

                <label class="profile-label">
                    Số điện thoại
                </label>

                <div class="profile-value">
                    @Model.Sdt
                </div>

            </div>

            <div class="profile-group">

                <label class="profile-label">
                    Ngày tạo
                </label>

                <div class="profile-value">
                    @Model.NgayTao
                </div>

            </div>

        </div>

        <a asp-action="CapNhatThongTin"
           class="btn-edit">

            Chỉnh sửa thông tin

        </a>

    </div>

</div>