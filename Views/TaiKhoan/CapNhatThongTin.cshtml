@model VVD_2210900012_DATN.Models.NguoiDung

@{
    ViewData["Title"] = "Cập nhật thông tin";
}

<style>

    body {
        background: #f5f5f5;
    }

    .edit-container {
        max-width: 700px;
        margin: 50px auto;
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .edit-title {
        font-size: 38px;
        font-weight: bold;
        color: #444;
        margin-bottom: 10px;
    }

    .line {
        width: 80px;
        height: 4px;
        background: #35c4cf;
        margin-bottom: 40px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 10px;
    }

    .form-input {
        width: 100%;
        height: 52px;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 0 15px;
        font-size: 15px;
    }

    .btn-save {
        width: 100%;
        height: 55px;
        border: none;
        border-radius: 12px;
        background: #35c4cf;
        color: white;
        font-size: 17px;
        font-weight: bold;
    }

</style>

<div class="edit-container">

    <div class="edit-title">
        CHỈNH SỬA THÔNG TIN CÁ NHÂN
    </div>

    <div class="line"></div>

    <form asp-action="CapNhatThongTin"
          method="post">

        <input type="hidden"
               asp-for="MaNguoiDung" />

        <div class="form-group">

            <label class="form-label">
                Họ tên
            </label>

            <input asp-for="HoTen"
                   class="form-input" />

        </div>

        <div class="form-group">

            <label class="form-label">
                Email
            </label>

            <input asp-for="Email"
                   class="form-input" />

        </div>

        <div class="form-group">

            <label class="form-label">
                Số điện thoại
            </label>

            <input asp-for="Sdt"
                   class="form-input" />

        </div>

        <button type="submit"
                class="btn-save">

            Lưu thay đổi

        </button>

    </form>

</div>