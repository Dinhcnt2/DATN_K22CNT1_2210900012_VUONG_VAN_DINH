
@model List<VVD_2210900012_DATN.Controllers.GioHangItem>

@inject VVD_2210900012_DATN.Models.BookstoreContext _context

@{
    ViewData["Title"] = "Giỏ hàng";

    // ===== LẤY VOUCHER =====

    var voucherId =
        Context.Session.GetInt32("VoucherId");

    // ===== TÍNH TỔNG =====

    decimal tongTien =
        Model.Sum(x => x.Gia * x.SoLuong);

    VVD_2210900012_DATN.Models.Voucher? voucher = null;

    if (voucherId != null)
    {
        voucher = _context.Vouchers
            .FirstOrDefault(x => x.Id == voucherId);

        if (voucher != null)
        {
            decimal giamGia =
                voucher.GiamGia ?? 0;

            // 🔥 GIẢM %

            if (voucher.Loai == "PhanTram")
            {
                tongTien -=
                    tongTien * (giamGia / 100);
            }

            // 🔥 GIẢM TIỀN

            else
            {
                tongTien -= giamGia;
            }

            // 🔥 CHỐNG ÂM

            if (tongTien < 0)
            {
                tongTien = 0;
            }
        }
    }
}

<style>
    /* =========================
       ANIMATION
    ========================= */

    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes zoomIn {
        from

    {
        opacity: 0;
        transform: scale(.95);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    .cart-title {
        animation: fadeUp .7s ease;
    }

    .cart-table {
        animation: fadeUp .8s ease;
        transition: .3s;
    }

        .cart-table:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
        }

    .voucher-box {
        animation: fadeUp 1s ease;
        transition: .3s;
    }

        .voucher-box:hover {
            transform: translateY(-3px);
        }

    .order-box {
        animation: fadeUp 1.2s ease;
        transition: .3s;
    }

        .order-box:hover {
            transform: translateY(-3px);
        }

    .cart-table tbody tr {
        transition: .3s;
    }

        .cart-table tbody tr:hover {
            background: #fff8e7;
        }

    .price {
        transition: .3s;
    }

        .price:hover {
            color: #ff5722;
        }

    .total-price {
        animation: zoomIn .8s ease;
    }

    .main-btn {
        transition: .3s;
    }

        .main-btn:hover {
            transform: translateY(-3px);
        }

    .form-control {
        transition: .3s;
    }

        .form-control:focus {
            transform: scale(1.02);
        }

    .alert {
        animation: fadeUp .6s ease;
    }

    body {
        background: #f5f5f5;
    }

    .cart-title {
        font-size: 42px;
        font-weight: 800;
        color: #222;
    }

    .cart-table {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
    }

    .book-name {
        font-size: 20px;
        font-weight: 700;
    }

    .price {
        color: #dc3545;
        font-weight: 700;
        font-size: 20px;
    }

    .total-price {
        color: #0d6efd;
        font-size: 36px;
        font-weight: 800;
    }

    .voucher-box {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
    }

    .order-box {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
    }

    .main-btn {
        border-radius: 30px;
        padding: 12px 30px;
        font-weight: 700;
    }
</style>

<div class="container mt-5 mb-5">

    <h1 class="cart-title mb-4">

        🛒 Giỏ hàng của bạn

    </h1>

    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Loi"]

        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning shadow-sm rounded-4 p-4 fs-5">

            Giỏ hàng trống!

        </div>
    }
    else
    {
        <!-- TABLE -->

        <div class="cart-table mb-4">

            <table class="table align-middle text-center mb-0">

                <thead class="table-warning">

                    <tr>

                        <th>Sách</th>

                        <th>Giá</th>

                        <th>Số lượng</th>

                        <th>Tổng</th>

                        <th></th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- TÊN -->

                            <td class="book-name">

                                @item.TenSach

                            </td>

                            <!-- GIÁ -->

                            <td class="price">

                                @item.Gia.ToString("N0") đ

                            </td>

                            <!-- SỐ LƯỢNG -->

                            <td style="width:220px;">

                                <input type="number"
                                       min="1"
                                       value="@item.SoLuong"
                                       class="form-control quantity"
                                       data-id="@item.Id" />

                            </td>

                            <!-- TOTAL -->

                            <td class="fw-bold text-success item-total fs-5">

                                @((item.Gia * item.SoLuong).ToString("N0")) đ

                            </td>

                            <!-- XOÁ -->

                            <td>

                                <a href="/GioHang/Xoa/@item.Id"
                                   class="btn btn-danger btn-sm rounded-pill px-3">

                                    Xoá

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- TOTAL -->

        <div class="text-end mb-4">

            @if (voucher != null)
            {
                <div class="text-success mb-2 fs-5">

                    ✅ Đã áp dụng voucher:
                    <strong>@voucher.MaCode</strong>

                </div>
            }

            <div class="total-price">

                Tổng tiền:

                <span id="cart-total">

                    @tongTien.ToString("N0") đ

                </span>

            </div>

        </div>

        <!-- VOUCHER -->

        <div class="voucher-box mb-4">

            <h4 class="mb-4">

                🎟 Voucher

            </h4>

            <!-- NHẬP CODE -->

            <div class="d-flex mb-3">

                <input type="text"
                       id="voucherCode"
                       class="form-control"
                       placeholder="Nhập mã voucher..." />

                <button class="btn btn-primary ms-2 main-btn"
                        onclick="applyVoucher()">

                    Áp dụng

                </button>

            </div>

            <!-- MODAL -->

            <button class="btn btn-warning main-btn"
                    onclick="openVoucherModal()">

                🎟 Chọn Voucher

            </button>

        </div>

        <!-- FORM -->

        <div class="order-box">

            <h3 class="mb-4">

                📦 Thông tin nhận hàng

            </h3>

            <form method="post"
                  action="/GioHang/DatHang">

                <input name="ten"
                       class="form-control mb-3"
                       placeholder="👤 Tên người nhận"
                       required />

                <input name="sdt"
                       class="form-control mb-3"
                       placeholder="📞 Số điện thoại"
                       required />

                <input name="diachi"
                       class="form-control mb-4"
                       placeholder="🏠 Địa chỉ"
                       required />

                <button class="btn btn-success w-100 btn-lg main-btn">

                    ✅ Đặt hàng ngay

                </button>

            </form>

        </div>
    }

</div>

<!-- MODAL -->

<div class="modal fade"
     id="voucherModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5>

                    🎟 Chọn Voucher

                </h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body"
                 id="voucherList">

                ⏳ Đang tải...

            </div>

        </div>

    </div>

</div>

<!-- SCRIPT -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>

    // ===== UPDATE REALTIME =====

    $(".quantity").on("change", function () {

        var input =
            $(this);

        var id =
            input.data("id");

        var soluong =
            input.val();

        var row =
            input.closest("tr");

        $.post(

            "/GioHang/UpdateAjax",

            {
                id: id,
                soluong: soluong
            },

            function (res) {

                // 🔥 FAIL

                if (!res.success) {

                    alert(res.message);

                    location.reload();

                    return;
                }

                // 🔥 SUCCESS

                row.find(".item-total").text(

                    res.itemTotal.toLocaleString()
                    + " đ"
                );

                $("#cart-total").text(

                    res.cartTotal.toLocaleString()
                    + " đ"
                );
            });
    });

    // ===== NHẬP VOUCHER =====

    function applyVoucher() {

        var code =
            $("#voucherCode").val();

        if (!code) {

            alert("Nhập mã voucher!");

            return;
        }

        $.post(

            "/GioHang/NhapVoucher",

            {
                code: code
            },

            function (res) {

                if (res.success) {

                    alert("Áp dụng thành công!");

                    location.reload();

                } else {

                    alert(res.message);
                }
            });
    }

    // ===== MODAL =====

    function openVoucherModal() {

        var modal =
            new bootstrap.Modal(

                document.getElementById(
                    'voucherModal'
                )
            );

        modal.show();

        $("#voucherList").html(
            "⏳ Đang tải..."
        );

        $.ajax({

            url: "/GioHang/GetVoucherList",

            type: "GET",

            success: function (data) {

                $("#voucherList")
                    .html(data);
            },

            error: function () {

                $("#voucherList").html(

                    "<span class='text-danger'>Lỗi load voucher</span>"
                );
            }
        });
    }

    // ===== CHỌN VOUCHER =====

    function chonVoucher(id) {

        $.post(

            "/GioHang/ChonVoucher",

            {
                id: id
            },

            function () {

                location.reload();
            });
    }

</script>
```
