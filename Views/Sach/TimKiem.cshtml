@model dynamic

@{
    ViewData["Title"] = "Tìm kiếm sách";
}

<style>

    body {
        background: #f5f5f5;
    }

    .search-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 30px;
        color: #222;
    }

    .book-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        transition: 0.3s;
        height: 100%;
    }

        .book-card:hover {
            transform: translateY(-5px);
        }

    .book-img {
        width: 100%;
        height: 320px;
        object-fit: cover;
    }

    .book-body {
        padding: 16px;
    }

    .book-name {
        font-size: 20px;
        font-weight: 700;
        color: #222;
        min-height: 60px;
    }

    .book-author {
        color: #666;
        margin-top: 10px;
    }

    .book-category {
        color: #0d6efd;
        font-weight: 600;
    }

    .book-price {
        color: red;
        font-size: 24px;
        font-weight: 700;
        margin-top: 10px;
    }

    .detail-btn {
        margin-top: 15px;
        border-radius: 30px;
        font-weight: 600;
    }

    .empty-box {
        background: white;
        padding: 40px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

</style>

<div class="container mt-4">

    <div class="search-title">

        🔍 Kết quả tìm kiếm:
        "@ViewBag.Keyword"

    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-box">

            <h3>
                😢 Không tìm thấy sách
            </h3>

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-3 mb-4">

                    <div class="book-card">

                        <img src="~/images/@item.AnhBia"
                             class="book-img" />

                        <div class="book-body">

                            <div class="book-name">

                                @item.TenSach

                            </div>

                            <div class="book-author">

                                ✍ Tác giả:
                                @item.TacGia

                            </div>

                            <div class="book-category">

                                📚 @item.DanhMuc

                            </div>

                            <div class="book-price">

                                @item.Gia.ToString("N0") đ

                            </div>

                            <a asp-action="ChiTiet"
                               asp-route-id="@item.Id"
                               class="btn btn-primary w-100 detail-btn">

                                Xem chi tiết

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>