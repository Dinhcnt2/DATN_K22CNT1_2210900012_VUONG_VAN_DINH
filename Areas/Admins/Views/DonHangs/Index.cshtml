@model IEnumerable<VVD_2210900012_DATN.Models.DonHang>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<style>
    /* =========================
       ANIMATION
    ========================= */

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes zoomIn {
        from {
            opacity: 0;
            transform: scale(.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes slideLeft {
        from {
            opacity: 0;
            transform: translateX(-40px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes pulseGlow {

        0% {
            box-shadow: 0 0 0 rgba(255,106,0,0);
        }

        50% {
            box-shadow: 0 0 25px rgba(255,106,0,.5);
        }

        100% {
            box-shadow: 0 0 0 rgba(255,106,0,0);
        }
    }

    /* ===== TITLE ===== */

    h1 {
        animation: slideLeft .7s ease;
    }

    /* ===== FILTER ===== */

    .card-box {
        animation: fadeUp .8s ease;
        transition: .35s;
    }

        .card-box:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,.15);
        }

    /* ===== CREATE BUTTON ===== */

    .btn-create {
        transition: .3s;
        animation: pulseGlow 3s infinite;
    }

        .btn-create:hover {
            transform: translateY(-3px) scale(1.05);
            color: white;
        }

    /* ===== TABLE ===== */

    .table-custom {
        animation: fadeUp 1s ease;
    }

        .table-custom tbody tr {
            transition: .3s;
        }

            .table-custom tbody tr:hover {
                background: #fff4eb;
                transform: scale(1.01);
            }

    /* ===== PRICE ===== */

    .price {
        transition: .3s;
    }

        .price:hover {
            color: #ff5722;
            transform: scale(1.08);
        }

    /* ===== BADGE ===== */

    .badge {
        transition: .3s;
    }

        .badge:hover {
            transform: scale(1.08);
            box-shadow: 0 5px 15px rgba(0,0,0,.15);
        }

    /* ===== ACTION BUTTON ===== */

    .btn-action {
        transition: .3s;
    }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,.2);
        }

    /* ===== INPUT FILTER ===== */

    .form-control {
        transition: .3s;
    }

        .form-control:focus {
            transform: scale(1.02);
            box-shadow: 0 0 15px rgba(13,110,253,.25);
        }
    body {
        background: #f5f6fa;
    }

    h1 {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .card-box {
        background: #fff;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .btn-create {
        background: linear-gradient(45deg, #ff6a00, #ff914d);
        color: white;
        padding: 8px 15px;
        border-radius: 8px;
        text-decoration: none;
    }

    .table-custom thead {
        background: linear-gradient(45deg, #ff6a00, #ff914d);
        color: white;
    }

    .table-custom th,
    .table-custom td {
        text-align: center;
        vertical-align: middle;
    }

    .price {
        color: red;
        font-weight: bold;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
    }

    .waiting {
        background: orange;
        color: white;
    }

    .processing {
        background: #17a2b8;
        color: white;
    }

    .done {
        background: #28a745;
        color: white;
    }

    .cancel {
        background: #dc3545;
        color: white;
    }

    .btn-action {
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 13px;
        text-decoration: none;
    }

    .edit {
        background: #ffc107;
        color: black;
    }

    .detail {
        background: #17a2b8;
        color: white;
    }

    .delete {
        background: #dc3545;
        color: white;
    }
</style>

<h1>📦 Quản lý đơn hàng</h1>

<!-- ================= FILTER ================= -->

<div class="card-box mb-3">

    <form method="get">

        <div class="row">

            <!-- STATUS -->

            <div class="col-md-3">

                <select name="status"
                        class="form-control">

                    <option value="">
                        -- Tất cả trạng thái --
                    </option>

                    <option value="ChoXacNhan"
                            selected="@(ViewBag.Status == "ChoXacNhan")">

                        Chờ xác nhận

                    </option>

                    <option value="DangXuLy"
                            selected="@(ViewBag.Status == "DangXuLy")">

                        Đang xử lý

                    </option>

                    <option value="HoanThanh"
                            selected="@(ViewBag.Status == "HoanThanh")">

                        Hoàn thành

                    </option>

                    <option value="DaHuy"
                            selected="@(ViewBag.Status == "DaHuy")">

                        Đã huỷ

                    </option>

                </select>

            </div>

            <!-- FROM -->

            <div class="col-md-3">

                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control" />

            </div>

            <!-- TO -->

            <div class="col-md-3">

                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control" />

            </div>

            <!-- BUTTON -->

            <div class="col-md-3">

                <button type="submit"
                        class="btn btn-primary w-100">

                    🔍 Lọc đơn hàng

                </button>

            </div>

        </div>

    </form>

</div>

<p>
    <a asp-action="Create"
       class="btn-create">

        ➕ Tạo đơn

    </a>
</p>

<div class="card-box">

    <table class="table table-hover table-custom">

        <thead>

            <tr>

                <th>Mã</th>

                <th>Khách</th>

                <th>SĐT</th>

                <th>Tổng</th>

                <th>Voucher</th>

                <th>Thanh toán</th>

                <th>Trạng thái</th>

                <th>Ngày</th>

                <th></th>

            </tr>

        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <!-- MÃ -->

                        <td>
                            <b>@item.MaDonHangCode</b>
                        </td>

                        <!-- USER -->

                        <td>
                            @item.HoTen
                        </td>

                        <!-- PHONE -->

                        <td>
                            @item.SoDienThoai
                        </td>

                        <!-- TOTAL -->

                        <td class="price">

                            @item.TongTien?.ToString("N0") đ

                        </td>

                        <!-- VOUCHER -->

                        <td>

                            @(item.Voucher != null
                                ? item.Voucher.MaCode
                                : "Không")

                        </td>

                        <!-- THANH TOÁN -->

                        <td>

                            @if (item.TrangThaiThanhToan
                           == "ChuaThanhToan")
                            {
                                <a asp-action="CapNhatThanhToan"
                                   asp-route-id="@item.MaDonHang"
                                   asp-route-status="DaThanhToan"
                                   class="badge cancel">

                                    💳 Xác nhận TT

                                </a>
                            }
                            else
                            {
                                <span class="badge done">

                                    Đã TT

                                </span>
                            }

                        </td>

                        <!-- TRẠNG THÁI -->

                        <td>

                            @if (item.TrangThaiThanhToan
                           == "ChuaThanhToan")
                            {
                                <span class="badge cancel">

                                    Chưa TT

                                </span>
                            }
                            else if (item.TrangThai
                            == "ChoXacNhan")
                            {
                                <a asp-action="CapNhatTrangThai"
                                   asp-route-id="@item.MaDonHang"
                                   asp-route-status="DangXuLy"
                                   class="badge waiting">

                                    ⚙️ Xử lý

                                </a>
                            }
                            else if (item.TrangThai
                            == "DangXuLy")
                            {
                                <a asp-action="CapNhatTrangThai"
                                   asp-route-id="@item.MaDonHang"
                                   asp-route-status="HoanThanh"
                                   class="badge processing">

                                    ✅ Hoàn thành

                                </a>
                            }
                            else if (item.TrangThai
                            == "HoanThanh")
                            {
                                <span class="badge done">

                                    Hoàn thành

                                </span>
                            }
                            else
                            {
                                <span class="badge cancel">

                                    Huỷ

                                </span>
                            }

                        </td>

                        <!-- DATE -->

                        <td>

                            @(item.NgayDat?.ToString("dd/MM/yyyy"))

                        </td>

                        <!-- ACTION -->

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.MaDonHang"
                               class="btn-action edit">

                                Sửa

                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.MaDonHang"
                               class="btn-action detail">

                                Xem

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.MaDonHang"
                               class="btn-action delete">

                                Xoá

                            </a>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="9"
                        class="text-danger fw-bold text-center">

                        Không có đơn hàng nào

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>