@model VVD_2210900012_DATN.Models.DanhGia

@{
    ViewData["Title"] = "Xóa đánh giá";
}

<style>

    body {
        background: #f5f6fa;
    }

    .delete-container {
        max-width: 850px;
        margin: 40px auto;
    }

    .delete-card {
        background: white;
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    /* ===== TITLE ===== */

    .page-title {
        text-align: center;
        font-size: 40px;
        font-weight: 800;
        margin-bottom: 10px;
        color: #dc3545;
    }

    .warning-text {
        text-align: center;
        font-size: 18px;
        color: #666;
        margin-bottom: 35px;
    }

    /* ===== INFO ===== */

    .info-item {
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid #eee;
    }

    .info-label {
        font-size: 18px;
        font-weight: 700;
        color: #ff5722;
        margin-bottom: 8px;
    }

    .info-value {
        font-size: 18px;
        color: #333;
        word-break: break-word;
    }

    .content-box {
        background: #f8f9fa;
        padding: 18px;
        border-radius: 15px;
        line-height: 1.8;
        white-space: pre-wrap;
    }

    /* ===== STAR ===== */

    .star-box {
        font-size: 24px;
    }

    /* ===== BUTTON ===== */

    .btn-group-custom {
        margin-top: 35px;
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-custom {
        padding: 12px 24px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: 700;
        border: none;
        transition: 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
        }

    .btn-delete {
        background: linear-gradient(120deg,#dc3545,#ff4d4f);
        color: white;
    }

    .btn-back {
        background: linear-gradient(120deg,#007bff,#00c6ff);
        color: white;
    }
</style>

<div class="delete-container">

    <div class="delete-card">

        <!-- TITLE -->

        <div class="page-title">

            🗑 Xóa đánh giá

        </div>

        <div class="warning-text">

            Bạn có chắc chắn muốn xóa đánh giá này không?

        </div>

        <!-- SỐ SAO -->

        <div class="info-item">

            <div class="info-label">

                ⭐ Số sao

            </div>

            <div class="info-value star-box">

                @for (int i = 0; i < Model.SoSao; i++)
                {
                    <span>⭐</span>
                }

            </div>

        </div>

        <!-- NỘI DUNG -->

        <div class="info-item">

            <div class="info-label">

                📝 Nội dung đánh giá

            </div>

            <div class="content-box">

                @Model.NoiDung

            </div>

        </div>

        <!-- NGÀY ĐÁNH GIÁ -->

        <div class="info-item">

            <div class="info-label">

                📅 Ngày đánh giá

            </div>

            <div class="info-value">

                @Model.NgayDanhGia?.ToString("dd/MM/yyyy HH:mm")

            </div>

        </div>

        <!-- NGƯỜI DÙNG -->

        <div class="info-item">

            <div class="info-label">

                👤 Người dùng

            </div>

            <div class="info-value">

                User #@Model.MaNguoiDungNavigation?.MaNguoiDung

            </div>

        </div>

        <!-- SẢN PHẨM -->

        <div class="info-item">

            <div class="info-label">

                📚 Sản phẩm

            </div>

            <div class="info-value">

                SP #@Model.SanPham?.Id

            </div>

        </div>

        <!-- FORM -->

        <form asp-action="Delete">

            <input type="hidden"
                   asp-for="Id" />

            <div class="btn-group-custom">

                <button type="submit"
                        class="btn-custom btn-delete">

                    🗑 Xác nhận xóa

                </button>

                <a asp-action="Index"
                   class="btn-custom btn-back">

                    ← Quay lại danh sách

                </a>

            </div>

        </form>

    </div>

</div>