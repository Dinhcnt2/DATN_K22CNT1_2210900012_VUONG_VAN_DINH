@model IEnumerable<VVD_2210900012_DATN.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            📚 Danh sách sản phẩm
        </h5>

        <a asp-action="Create"
           class="btn btn-primary">
            ➕ Thêm sách
        </a>

    </div>

    <div class="card-body">

        <!-- ================= SEARCH ================= -->

        <form method="get"
              class="row mb-3">

            <!-- TÊN SÁCH -->

            <div class="col-md-4">

                <input type="text"
                       name="keyword"
                       value="@ViewBag.Keyword"
                       class="form-control"
                       placeholder="🔍 Tìm tên sách..." />

            </div>

            <!-- DANH MỤC -->

            <div class="col-md-3">

                <select name="danhMucId"
                        asp-items="ViewBag.DanhMucId"
                        class="form-select">

                    <option value="">
                        -- Tất cả danh mục --
                    </option>

                </select>

            </div>

            <!-- BUTTON -->

            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-primary w-100">

                    Tìm kiếm

                </button>

            </div>

        </form>

        <!-- ================= ALERT ================= -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <!-- ================= TABLE ================= -->

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark text-center">

                <tr>

                    <th>ID</th>

                    <th>Tên sách</th>

                    <th>Tác giả</th>

                    <th>Nhà xuất bản</th>

                    <th>Giá</th>

                    <th>Ảnh</th>

                    <th>Danh mục</th>

                    <th>Trạng thái</th>

                    <th>Thao tác</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr class="text-center">

                        <!-- ID -->

                        <td>
                            @item.Id
                        </td>

                        <!-- TÊN -->

                        <td>
                            @item.TenSach
                        </td>

                        <!-- TÁC GIẢ -->

                        <td>
                            @item.TacGia
                        </td>

                        <!-- NXB -->

                        <td>
                            @item.NhaXuatBan
                        </td>

                        <!-- GIÁ -->

                        <td class="text-danger fw-bold">

                            @item.GiaGoc.ToString("N0") đ

                        </td>

                        <!-- ẢNH -->

                        <td>

                            <img src="~/images/@item.AnhBia"
                                 width="60"
                                 class="rounded shadow-sm" />

                        </td>

                        <!-- DANH MỤC -->

                        <td>

                            @item.DanhMuc?.TenDanhMuc

                        </td>

                        <!-- TRẠNG THÁI -->

                        <td>

                            @if (item.IsActive == true)
                            {
                                <span class="badge bg-success">
                                    Đang bán
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Ngừng bán
                                </span>
                            }

                        </td>

                        <!-- THAO TÁC -->

                        <td>

                            <!-- EDIT -->

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">

                                ✏️ Sửa

                            </a>

                            <!-- DETAILS -->

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-info">

                                👁 Xem

                            </a>

                            @if (item.IsActive == true)
                            {
                                <!-- DELETE -->

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      style="display:inline;">

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Bạn có chắc muốn xóa sách này không?');">

                                        🗑 Xóa

                                    </button>

                                </form>
                            }
                            else
                            {
                                <!-- RESTORE -->

                                <a asp-action="Restore"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-success">

                                    🔄 Khôi phục

                                </a>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>