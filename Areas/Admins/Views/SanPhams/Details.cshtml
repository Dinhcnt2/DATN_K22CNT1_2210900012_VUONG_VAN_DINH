@model VVD_2210900012_DATN.Models.SanPham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<style>

    body {
        background: #f5f5f5;
        font-family: Arial, Helvetica, sans-serif;
    }

    .details-container {
        max-width: 1200px;
        margin: 40px auto;
        background: #fff;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .details-title {
        font-size: 38px;
        font-weight: 800;
        color: #222;
        margin-bottom: 35px;
    }

    .top-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 40px;
        margin-bottom: 40px;
    }

    .book-image {
        width: 100%;
        border-radius: 18px;
        object-fit: cover;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
    }

    .info-box {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .book-name {
        font-size: 34px;
        font-weight: 800;
        color: #111;
    }

    .price {
        color: red;
        font-size: 30px;
        font-weight: 800;
    }

    .badge-active {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 30px;
        background: #28a745;
        color: white;
        font-weight: 700;
    }

    .badge-stop {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 30px;
        background: #dc3545;
        color: white;
        font-weight: 700;
    }

    .details-grid {
        display: grid;
        grid-template-columns: 250px 1fr;
        gap: 16px;
    }

    .details-label {
        background: #f8f9fa;
        padding: 14px;
        border-radius: 12px;
        font-weight: 700;
        color: #333;
    }

    .details-value {
        background: white;
        border: 1px solid #eee;
        padding: 14px;
        border-radius: 12px;
        color: #444;
        word-break: break-word;
    }

    .btn-group-custom {
        margin-top: 40px;
        display: flex;
        gap: 16px;
    }

    .btn-custom {
        padding: 14px 28px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
    }

    .btn-edit {
        background: #0d6efd;
        color: white;
    }

    .btn-edit:hover {
        background: #0b5ed7;
        color: white;
    }

    .btn-back {
        background: #6c757d;
        color: white;
    }

    .btn-back:hover {
        background: #5c636a;
        color: white;
    }

</style>

<div class="details-container">

    <div class="details-title">

        📚 Chi tiết sản phẩm

    </div>

    <!-- TOP -->

    <div class="top-layout">

        <!-- ẢNH -->

        <div>

            <img src="~/images/@Model.AnhBia"
                 class="book-image" />

        </div>

        <!-- THÔNG TIN -->

        <div class="info-box">

            <div class="book-name">

                @Html.DisplayFor(model => model.TenSach)

            </div>

            <div class="price">

                @(Model.GiaSauGiam?.ToString("N0")) đ

            </div>

            <div>

                @if (Model.IsActive == true)
                {
                    <span class="badge-active">

                        Đang bán

                    </span>
                }
                else
                {
                    <span class="badge-stop">

                        Ngừng bán

                    </span>
                }

            </div>

            <div>

                <b>Tác giả:</b>

                @Html.DisplayFor(model => model.TacGia)

            </div>

            <div>

                <b>Nhà xuất bản:</b>

                @Html.DisplayFor(model => model.NhaXuatBan)

            </div>

            <div>

                <b>Năm XB:</b>

                @Html.DisplayFor(model => model.NamXuatBan)

            </div>

        </div>

    </div>

    <!-- DETAILS -->

    <div class="details-grid">

        <div class="details-label">
            Slug
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.Slug)
        </div>

        <div class="details-label">
            Số trang
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.SoTrang)
        </div>

        <div class="details-label">
            ISBN
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.Isbn)
        </div>

        <div class="details-label">
            Mô tả ngắn
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.MoTaNgan)
        </div>

        <div class="details-label">
            Mô tả chi tiết
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.MoTaChiTiet)
        </div>

        <div class="details-label">
            Giá gốc
        </div>

        <div class="details-value">
            @Model.GiaGoc.ToString("N0") đ
        </div>

        <div class="details-label">
            Phần trăm giảm
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.PhanTramGiam) %
        </div>

        <div class="details-label">
            Meta title
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.MetaTitle)
        </div>

        <div class="details-label">
            Meta description
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.MetaDescription)
        </div>

        <div class="details-label">
            Meta keyword
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.MetaKeyword)
        </div>

        <div class="details-label">
            Nổi bật
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.NoiBat)
        </div>

        <div class="details-label">
            Ngày tạo
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.CreatedAt)
        </div>

        <div class="details-label">
            Ngày cập nhật
        </div>

        <div class="details-value">
            @Html.DisplayFor(model => model.UpdatedAt)
        </div>

        <div class="details-label">
            Danh mục
        </div>

        <div class="details-value">
            @(Model.DanhMuc != null
                ? Model.DanhMuc.Id
                : "")
        </div>

    </div>

    <!-- BUTTON -->

    <div class="btn-group-custom">

        <a asp-action="Edit"
           asp-route-id="@Model?.Id"
           class="btn-custom btn-edit">

            ✏️ Chỉnh sửa

        </a>

        <a asp-action="Index"
           class="btn-custom btn-back">

            ← Quay lại

        </a>

    </div>

</div>