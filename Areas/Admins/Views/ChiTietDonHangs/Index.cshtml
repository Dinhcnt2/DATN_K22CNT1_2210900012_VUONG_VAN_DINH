@model IEnumerable<VVD_2210900012_DATN.Models.ChiTietDonHang>

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<style>
    body {
        background: #f4f6f9;
        font-family: "Segoe UI", sans-serif;
    }

    h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #333;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .btn-create {
        background: linear-gradient(45deg, #28a745, #4cd964);
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
    }

    .card-box {
        background: #fff;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.06);
    }

    .table-custom {
        border-radius: 10px;
        overflow: hidden;
    }

        .table-custom thead {
            background: linear-gradient(45deg, #007bff, #00c6ff);
            color: white;
            font-size: 14px;
        }

        .table-custom th, .table-custom td {
            text-align: center;
            vertical-align: middle;
            padding: 12px;
        }

        .table-custom tbody tr:hover {
            background: #f1f7ff;
            transition: 0.2s;
        }

    .price {
        color: #e74c3c;
        font-weight: bold;
    }

    .badge-id {
        background: #6c757d;
        color: white;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 12px;
    }

    .badge-order {
        background: #007bff;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .btn-group {
        display: flex;
        justify-content: center;
        gap: 6px;
    }

    .btn-action {
        border-radius: 6px;
        padding: 5px 10px;
        font-size: 13px;
        text-decoration: none;
        color: white;
    }

    .edit {
        background: #f39c12;
    }

    .detail {
        background: #3498db;
    }

    .delete {
        background: #e74c3c;
    }

    .btn-action:hover {
        opacity: 0.85;
    }
</style>

<div class="top-bar">
    <h1>📦 Chi tiết đơn hàng</h1>
    <a asp-action="Create" class="btn-create">➕ Thêm mới</a>
</div>

<div class="card-box">

    <table class="table table-hover table-custom">
        <thead>
            <tr>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
                <th>Biến thể</th>
                <th>Mã đơn</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SoLuong</td>

                    <td class="price">
                        @item.DonGia.ToString("N0") đ
                    </td>

                    <td class="price">
                        @item.ThanhTien.ToString("N0") đ
                    </td>

                    <td>
                        <span class="badge-id">
                            #@item.BienThe?.Id
                        </span>
                    </td>

                    <td>
                        <span class="badge-order">
                            @(item.MaDonHangNavigation != null
                                ? "DH" + item.MaDonHangNavigation.MaDonHang
                                : "N/A")
                        </span>
                    </td>

                    <td>
                        <div class="btn-group">
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-action edit">✏️</a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn-action detail">👁</a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn-action delete"
                               onclick="return confirm('Xoá chi tiết này?')">🗑</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>