            border-color: #007bff;
            box-shadow: 0 0 8px rgba(0,123,255,0.3);
        }

    .btn-primary {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        background: linear-gradient(45deg, #28a745, #5cd65c);
        border: none;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-primary:hover {
            transform: scale(1.03);
            background: linear-gradient(45deg, #218838, #4cc94c);
        }

    div > a {
        display: inline-block;
        margin-top: 15px;
        font-weight: bold;
        color: #007bff;
        text-decoration: none;
    }

        div > a:hover {
