}
<style>
    body {
        background: linear-gradient(120deg, #f0f2f5, #e0eafc);
        font-family: 'Segoe UI', sans-serif;
    }

    h1 {
        font-weight: bold;
        color: #333;
        margin-bottom: 5px;
    }

    h4 {
        color: #666;
        margin-bottom: 15px;
    }

    hr {
        margin-bottom: 20px;
    }

    .row {
        margin-top: 20px;
    }

    .col-md-4 {
        background: #fff;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
