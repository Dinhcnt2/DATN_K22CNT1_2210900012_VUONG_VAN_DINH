@model VVD_2210900012_DATN.Models.Voucher

@{
    ViewData["Title"] = "Xóa Voucher";
}

<div class="container delete-container">
    <h1>Xóa Voucher</h1>
    <h3>Bạn có chắc chắn muốn xóa voucher này không?</h3>

    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.MaCode)
            </dt>
            <dd class="col-sm-10 text-danger fw-bold">
                @Html.DisplayFor(model => model.MaCode)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.GiamGia)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.GiamGia)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Loai)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Loai)
            </dd>

            
        </dl>

        <form asp-action="Delete" class="form-actions">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger btn-delete-confirm">
                <i class="fa fa-trash"></i> Xác nhận xóa
            </button>
            <a asp-action="Index" class="back-link">Quay lại danh sách</a>
        </form>
    </div>
</div>