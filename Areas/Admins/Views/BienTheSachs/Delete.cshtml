@model VVD_2210900012_DATN.Models.BienTheSach

@{
    ViewData["Title"] = "Delete";
}

<style>
    body {
        background: linear-gradient(135deg, #fff1f2, #fef2f2);
        font-family: 'Segoe UI', sans-serif;
    }

    h1 {
        font-size: 28px;
        font-weight: bold;
        color: #b91c1c;
        margin-bottom: 5px;
    }

    h3 {
        color: #dc2626;
        font-weight: 600;
        margin-bottom: 20px;
    }

    h4 {
        color: #374151;
        margin-bottom: 15px;
    }

    hr {
        border: none;
        height: 1px;
        background: #e5e7eb;
        margin-bottom: 20px;
    }

    .row {
        display: flex;
        justify-content: center;
    }

    dl.row {
        background: #ffffff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        max-width: 600px;
        margin: auto;
    }

    dt {
        font-weight: 600;
        color: #334155;
        padding: 10px 0;
    }

    dd {
        padding: 10px 0;
        border-bottom: 1px solid #e5e7eb;
        color: #111827;
    }

        dd:last-child {
            border-bottom: none;
        }

    form {
        text-align: center;
        margin-top: 20px;
    }

    .btn-danger {
        padding: 10px 18px;
        border-radius: 10px;
        background: linear-gradient(45deg, #dc2626, #ef4444);
        border: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-danger:hover {
            transform: scale(1.05);
            background: linear-gradient(45deg, #b91c1c, #dc2626);
        }

    a {
        margin-left: 10px;
        padding: 8px 14px;
        border-radius: 8px;
        background: #6366f1;
        color: white;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        a:hover {
            opacity: 0.85;
            transform: translateY(-1px);
        }
</style>

<h1>⚠️ Xoá biến thể</h1>

<h3>Bạn có chắc muốn xoá dữ liệu này không?</h3>

<div>
    <h4>Thông tin biến thể</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SoLuongTon)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SoLuongTon)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LoaiBia)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LoaiBia.MaLoaiBia)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NgonN)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NgonN.MaNgonNgu)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SanPham)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SanPham.Id)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="🗑 Xoá ngay" class="btn btn-danger" />
        <a asp-action="Index">⬅ Quay lại</a>
    </form>
</div>