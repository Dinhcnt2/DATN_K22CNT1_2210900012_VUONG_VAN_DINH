@model VVD_2210900012_DATN.Models.BienTheSach

@{
    ViewData["Title"] = "Xoá biến thể sách";
}

<style>
    body {
        background: linear-gradient(135deg,#fff1f2,#fef2f2);
        font-family: 'Segoe UI',sans-serif;
    }

    .delete-box {
        max-width: 850px;
        margin: 30px auto;
        background: #fff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 15px 35px rgba(0,0,0,.08);
        animation: fadeUp .6s ease;
    }

    h1 {
        color: #dc2626;
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    h3 {
        color: #991b1b;
        margin-bottom: 25px;
    }

    .info-table {
        width: 100%;
    }

        .info-table tr {
            border-bottom: 1px solid #eee;
        }

        .info-table th {
            width: 220px;
            padding: 14px;
            color: #374151;
        }

        .info-table td {
            padding: 14px;
            color: #111827;
            font-weight: 600;
        }

    .price {
        color: #dc2626;
        font-size: 22px;
        font-weight: bold;
    }

    .stock {
        color: #16a34a;
        font-weight: bold;
    }

    .btn-danger {
        border: none;
        padding: 12px 25px;
        border-radius: 12px;
        font-weight: bold;
        background: linear-gradient(45deg,#dc2626,#ef4444);
        transition: .3s;
    }

        .btn-danger:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(220,38,38,.25);
        }

    .btn-back {
        display: inline-block;
        margin-left: 10px;
        padding: 12px 25px;
        border-radius: 12px;
        text-decoration: none;
        color: white;
        background: linear-gradient(45deg,#6366f1,#4f46e5);
        transition: .3s;
    }

        .btn-back:hover {
            color: white;
            transform: translateY(-3px);
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="delete-box">

    <h1>⚠️ Xoá biến thể sách</h1>

    <h3>Bạn có chắc chắn muốn xoá biến thể này?</h3>

    <table class="info-table">

        <tr>
            <th>Sản phẩm</th>
            <td>@Model.SanPham?.TenSach</td>
        </tr>

        <tr>
            <th>Loại bìa</th>
            <td>@Model.LoaiBia?.TenLoaiBia</td>
        </tr>

        <tr>
            <th>Ngôn ngữ</th>
            <td>@Model.NgonN?.TenNgonNgu</td>
        </tr>

        <tr>
            <th>Số lượng tồn</th>
            <td class="stock">
                @Model.SoLuongTon
            </td>
        </tr>

        <tr>
            <th>Giá bán</th>
            <td class="price">
                @Model.GiaBan?.ToString("N0") đ
            </td>
        </tr>

    </table>

    <form asp-action="Delete" class="mt-4">

        <input type="hidden" asp-for="Id" />

        <input type="submit"
               value="🗑 Xoá ngay"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn-back">

            ⬅ Quay lại

        </a>

    </form>

</div>