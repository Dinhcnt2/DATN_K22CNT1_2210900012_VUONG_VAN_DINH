
@model VVD_2210900012_DATN.Models.BienTheSach

@{
    ViewData["Title"] = "Details";
}

<style>
    body {
        background: linear-gradient(135deg, #eef2ff, #f8fafc);
        font-family: 'Segoe UI', sans-serif;
    }

    h1 {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 5px;
    }

    h4 {
        color: #64748b;
        margin-bottom: 15px;
    }

    hr {
        border: none;
        height: 1px;
        background: #e2e8f0;
        margin-bottom: 25px;
    }

    .row {
        display: flex;
        justify-content: center;
    }

    .col-sm-2 {
        font-weight: 600;
        color: #334155;
    }

    .col-sm-10 {
        color: #111827;
    }

    dl.row {
        background: #ffffff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        max-width: 700px;
        margin: auto;
        animation: fadeUp .5s ease;
    }

    dt {
        padding: 10px 0;
    }

    dd {
        padding: 10px 0;
        border-bottom: 1px solid #e5e7eb;
    }

        dd:last-child {
            border-bottom: none;
        }

    .price {
        color: #dc2626;
        font-weight: bold;
        font-size: 20px;
    }

    a {
        display: inline-block;
        margin-top: 20px;
        margin-right: 10px;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        a:hover {
            opacity: 0.85;
            transform: translateY(-2px);
        }

    .btn-edit {
        background: #facc15;
        color: #000;
    }

    .btn-back {
        background: #6366f1;
        color: white;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<h1>📄 Chi tiết biến thể</h1>

<div>
    <h4>Thông tin chi tiết</h4>

    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Số lượng tồn
        </dt>

        <dd class="col-sm-10">
            @Model.SoLuongTon
        </dd>

        <dt class="col-sm-2">
            Giá bán
        </dt>

        <dd class="col-sm-10">
            <span class="price">
                @Model.GiaBan?.ToString("N0") đ
            </span>
        </dd>

        <dt class="col-sm-2">
            Loại bìa
        </dt>

        <dd class="col-sm-10">
            @Model.LoaiBia?.MaLoaiBia
        </dd>

        <dt class="col-sm-2">
            Ngôn ngữ
        </dt>

        <dd class="col-sm-10">
            @Model.NgonN?.MaNgonNgu
        </dd>

        <dt class="col-sm-2">
            Sách
        </dt>

        <dd class="col-sm-10">
            @Model.SanPham?.TenSach
        </dd>

    </dl>

</div>

<div style="text-align:center;">

    <a asp-action="Edit"
       asp-route-id="@Model?.Id"
       class="btn-edit">

        ✏️ Sửa

    </a>

    <a asp-action="Index"
       class="btn-back">

        ⬅ Quay lại

    </a>

</div>

