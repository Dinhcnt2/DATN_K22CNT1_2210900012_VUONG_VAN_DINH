@model IEnumerable<VVD_2210900012_DATN.Models.BienTheSach>

@{
    ViewData["Title"] = "Quản lý biến thể sách";
}

<style>

    body {
        background: linear-gradient(135deg,#eef2ff,#f8fafc);
        font-family: 'Segoe UI',sans-serif;
    }

    .page-title {
        font-size: 32px;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 25px;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .btn-create {
        background: linear-gradient(45deg,#2563eb,#06b6d4);
        color: white;
        padding: 12px 20px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: .3s;
        box-shadow: 0 10px 20px rgba(37,99,235,.2);
    }

        .btn-create:hover {
            color: white;
            transform: translateY(-3px);
        }

    .card-box {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 15px 35px rgba(0,0,0,.08);
        animation: fadeUp .5s ease;
    }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background: linear-gradient(45deg,#4f46e5,#2563eb);
            color: white;
            text-align: center;
            vertical-align: middle;
            border: none;
            padding: 15px;
        }

        .table tbody td {
            text-align: center;
            vertical-align: middle;
            padding: 15px;
        }

        .table tbody tr {
            transition: .3s;
        }

            .table tbody tr:hover {
                background: #f8fafc;
                transform: scale(1.01);
            }

    .book-name {
        font-weight: 700;
        color: #1e293b;
    }

    .price {
        color: #dc2626;
        font-size: 18px;
        font-weight: 800;
    }

    .stock-good {
        display: inline-block;
        background: #dcfce7;
        color: #166534;
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: bold;
    }

    .stock-low {
        display: inline-block;
        background: #fee2e2;
        color: #991b1b;
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: bold;
    }

    .btn-action {
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        transition: .3s;
        margin: 2px;
        display: inline-block;
    }

        .btn-action:hover {
            transform: translateY(-2px);
        }

    .edit {
        background: #f59e0b;
        color: white;
    }

    .detail {
        background: #06b6d4;
        color: white;
    }

    .delete {
        background: #ef4444;
        color: white;
    }

    .empty {
        text-align: center;
        padding: 30px;
        color: #64748b;
        font-size: 18px;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="top-bar">

    <h1 class="page-title">
        📚 Quản lý biến thể sách
    </h1>

    <a asp-action="Create" class="btn-create">
        ➕ Thêm biến thể
    </a>

</div>

<div class="card-box">

    <table class="table table-hover">

        <thead>
            <tr>
                <th>Sách</th>
                <th>Loại bìa</th>
                <th>Ngôn ngữ</th>
                <th>Giá bán</th>
                <th>Tồn kho</th>
                <th width="220">Hành động</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td class="book-name">
                            @item.SanPham?.TenSach
                        </td>

                        <td>
                            @item.LoaiBia?.TenLoaiBia
                        </td>

                        <td>
                            @item.NgonN?.TenNgonNgu
                        </td>

                        <td>
                            <span class="price">
                                @(item.GiaBan?.ToString("N0")) đ
                            </span>
                        </td>

                        <td>

                            @if ((item.SoLuongTon ?? 0) > 10)
                            {
                                <span class="stock-good">
                                    @item.SoLuongTon
                                </span>
                            }
                            else
                            {
                                <span class="stock-low">
                                    @item.SoLuongTon
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-action edit">
                                ✏️ Sửa
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn-action detail">
                                👁 Xem
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn-action delete">
                                🗑 Xóa
                            </a>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="empty">
                        Chưa có biến thể sách nào
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>

