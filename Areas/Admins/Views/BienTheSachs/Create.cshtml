@model VVD_2210900012_DATN.Models.BienTheSach

@{
    ViewData["Title"] = "Thêm biến thể sách";
}

<style>

    body {
        background: linear-gradient(135deg,#eef2ff,#f8fafc);
        font-family: 'Segoe UI',sans-serif;
    }

    .create-box {
        max-width: 750px;
        margin: 30px auto;
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,.08);
        animation: fadeUp .6s ease;
    }

    h2 {
        text-align: center;
        margin-bottom: 25px;
        color: #2563eb;
        font-weight: 800;
    }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
        color: #374151;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px;
        transition: .3s;
    }

        .form-control:focus {
            transform: scale(1.02);
            box-shadow: 0 0 15px rgba(37,99,235,.2);
        }

    .btn-save {
        border: none;
        padding: 12px 25px;
        border-radius: 12px;
        background: linear-gradient(45deg,#16a34a,#22c55e);
        color: white;
        font-weight: bold;
        transition: .3s;
    }

        .btn-save:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(34,197,94,.25);
        }

    .btn-back {
        text-decoration: none;
        margin-left: 10px;
        padding: 12px 25px;
        border-radius: 12px;
        background: linear-gradient(45deg,#6366f1,#4f46e5);
        color: white;
        transition: .3s;
    }

        .btn-back:hover {
            color: white;
            transform: translateY(-3px);
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="create-box">

    <h2>📚 Thêm biến thể sách</h2>

    <form asp-action="Create">

        <div class="form-group">

            <label>Sách</label>

            <select asp-for="SanPhamId"
                    class="form-control"
                    asp-items="ViewBag.SanPhamId">

                <option value="">-- Chọn sách --</option>

            </select>

        </div>

        <div class="form-group">

            <label>Loại bìa</label>

            <select asp-for="LoaiBiaId"
                    class="form-control"
                    asp-items="ViewBag.LoaiBiaId">

                <option value="">-- Chọn loại bìa --</option>

            </select>

        </div>

        <div class="form-group">

            <label>Ngôn ngữ</label>

            <select asp-for="NgonNguId"
                    class="form-control"
                    asp-items="ViewBag.NgonNguId">

                <option value="">-- Chọn ngôn ngữ --</option>

            </select>

        </div>

        <div class="form-group">

            <label>Số lượng tồn kho</label>

            <input asp-for="SoLuongTon"
                   class="form-control" />

        </div>

        <!-- THÊM GIÁ BÁN -->

        <div class="form-group">

            <label>Giá bán (VNĐ)</label>

            <input asp-for="GiaBan"
                   class="form-control"
                   placeholder="Nhập giá bán..." />

            <span asp-validation-for="GiaBan"
                  class="text-danger"></span>

        </div>

        <button type="submit"
                class="btn-save">

            💾 Thêm biến thể

        </button>

        <a asp-action="Index"
           class="btn-back">

            ⬅ Quay lại

        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}