@model VVD_2210900012_DATN.Models.GioHang

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>GioHang</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Create">

            <!-- 🔥 HIỂN THỊ LỖI -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- ===== SESSION ID ===== -->
            <div class="form-group mb-2">
                <label asp-for="SessionId" class="control-label"></label>

                <input asp-for="SessionId" class="form-control" />

                <span asp-validation-for="SessionId" class="text-danger"></span>
            </div>

            <!-- ===== NGƯỜI DÙNG ===== -->
            <div class="form-group mb-2">
                <label asp-for="MaNguoiDung" class="control-label"></label>

                <select asp-for="MaNguoiDung"
                        class="form-control"
                        asp-items="ViewBag.MaNguoiDung ?? new List<SelectListItem>()">
                </select>

                <!-- 🔥 FIX: tránh NULL crash -->
                @if (ViewBag.MaNguoiDung == null)
                {
                    <small class="text-danger">
                        ⚠ Không có dữ liệu người dùng
                    </small>
                }
            </div>

            <!-- ===== GHI CHÚ ===== -->
            <div class="form-group mb-3">
                <label asp-for="GhiChu" class="control-label"></label>

                <input asp-for="GhiChu" class="form-control" />

                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>

            <!-- ===== SUBMIT ===== -->
            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary w-100" />
            </div>

        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">⬅ Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
