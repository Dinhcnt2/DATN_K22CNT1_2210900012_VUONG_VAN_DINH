@model IEnumerable<VVD_2210900012_DATN.Models.GioHangChiTiet>

@{
    ViewData["Title"] = "Chi tiết giỏ hàng";
}

<style>

    body {
        background: #f5f6fa;
    }

    /* ===== TITLE ===== */

    .page-title {
        font-size: 40px;
        font-weight: 800;
        margin-bottom: 25px;
        color: #222;
    }

    /* ===== CARD ===== */

    .card-box {
        background: white;
        padding: 30px;
        border-radius: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    /* ===== BUTTON CREATE ===== */

    .btn-create {
        background: linear-gradient(120deg,#28a745,#5cd65c);
        color: white;
        padding: 12px 20px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: 700;
        display: inline-block;
        margin-bottom: 25px;
        transition: 0.3s;
    }

        .btn-create:hover {
            transform: translateY(-2px);
            color: white;
            opacity: 0.95;
        }

    /* ===== TABLE ===== */

    .table-custom {
        overflow: hidden;
        border-radius: 20px;
    }

        .table-custom thead {
            background: linear-gradient(120deg,#007bff,#00c6ff);
            color: white;
        }

        .table-custom th {
            text-align: center;
            vertical-align: middle;
            padding: 18px;
            font-size: 15px;
            font-weight: 700;
            border: none;
        }

        .table-custom td {
            text-align: center;
            vertical-align: middle;
            padding: 18px;
            border-color: #f1f1f1;
        }

        .table-custom tbody tr {
            transition: 0.2s;
        }

            .table-custom tbody tr:hover {
                background: #f8fbff;
            }

    /* ===== IMAGE ===== */

    .book-img {
        width: 70px;
        height: 90px;
        object-fit: cover;
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    }

    /* ===== BOOK NAME ===== */

    .book-name {
        font-weight: 700;
        color: #222;
        font-size: 16px;
    }

    /* ===== USER ===== */

    .user-box {
        font-weight: 700;
        color: #007bff;
    }

    /* ===== PRICE ===== */

    .price {
        color: red;
        font-weight: 800;
        font-size: 16px;
    }

    /* ===== QUANTITY ===== */

    .quantity {
        background: #fff3cd;
        color: #856404;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 700;
        display: inline-block;
    }

    /* ===== ACTION ===== */

    .btn-action {
        padding: 8px 12px;
        border-radius: 10px;
        font-size: 14px;
        text-decoration: none;
        margin: 2px;
        display: inline-block;
        font-weight: 700;
        transition: 0.3s;
    }

        .btn-action:hover {
            transform: translateY(-2px);
        }

    .edit {
        background: #ffc107;
        color: black;
    }

    .detail {
        background: #17a2b8;
        color: white;
    }

    .delete {
        background: #dc3545;
        color: white;
    }

    /* ===== EMPTY ===== */

    .empty-box {
        background: white;
        padding: 50px;
        border-radius: 20px;
        text-align: center;
        font-size: 22px;
        font-weight: 700;
        color: #666;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }
</style>

<div class="container mt-4 mb-5">

    <!-- TITLE -->

    <div class="page-title">

        🛒 Chi tiết giỏ hàng

    </div>

    <!-- BUTTON -->

    <a asp-action="Create"
       class="btn-create">

        ➕ Thêm mới

    </a>

    @if (!Model.Any())
    {
        <div class="empty-box">

            😢 Chưa có sản phẩm nào trong giỏ hàng

        </div>
    }
    else
    {
        <div class="card-box">

            <table class="table table-hover table-custom">

                <thead>

                    <tr>

                        <th>
                            👤 Người dùng
                        </th>

                        <th>
                            📷 Ảnh
                        </th>

                        <th>
                            📚 Tên sách
                        </th>

                        <th>
                            🔢 Số lượng
                        </th>

                        <th>
                            💰 Đơn giá
                        </th>

                        <th>
                            💵 Thành tiền
                        </th>

                        <th>
                            ⚙ Hành động
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- USER -->

                            <td class="user-box">

                                @item.GioHang
                                .MaNguoiDungNavigation
                                ?.HoTen

                            </td>

                            <!-- IMAGE -->

                            <td>

                                <img src="~/images/@item.BienThe.SanPham.AnhBia"
                                     class="book-img" />

                            </td>

                            <!-- BOOK -->

                            <td class="book-name">

                                @item.BienThe.SanPham.TenSach

                            </td>

                            <!-- QUANTITY -->

                            <td>

                                <span class="quantity">

                                    x @item.SoLuong

                                </span>

                            </td>

                            <!-- PRICE -->

                            <td class="price">

                                @item.DonGia.ToString("N0") đ

                            </td>

                            <!-- TOTAL -->

                            <td class="price">

                                @item.ThanhTien.ToString("N0") đ

                            </td>

                            <!-- ACTION -->

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn-action edit">

                                    ✏️ Sửa

                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn-action detail">

                                    👁 Xem

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn-action delete"
                                   onclick="return confirm('Xóa sản phẩm này khỏi giỏ hàng?')">

                                    🗑 Xóa

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>